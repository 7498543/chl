# ============================================================
# 环境配置
# 复制此文件为 .env.{*} 并按需修改
# ============================================================

# ─── API 代理地址（后端服务地址，开发环境用 localhost）─────
NEXT_PUBLIC_API_PROXY=http://localhost:3000

# ─── API 基础路径 ──────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=/api

# ─── 站点信息 ──────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=CHL
NEXT_PUBLIC_SITE_DESCRIPTION=内容管理系统
