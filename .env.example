# ============================================================
# 项目环境配置
# 复制此文件为 .env 或 .env.{NODE_ENV} 并按需修改
# ============================================================

# ─── 服务器 ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── 数据库 ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chl
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chl

# ─── 文件上传 ────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=chl-jwt-secret-dev-2026

# ─── Swagger 文档（生产环境建议关闭）───────────────────
SWAGGER_ENABLED=true

# ─── 开放注册（生产环境建议关闭）───────────────────────
REGISTER_ENABLED=true

# ─── Redis ───────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# ─────────────────────────────────────────────────────
# PM2 集群配置（仅在使用 PM2 ecosystem 时生效）
# ─────────────────────────────────────────────────────
PM2_INSTANCES=1
PM2_EXEC_MODE=fork
PM2_MAX_MEMORY=1G
PM2_LOG_DIR=./logs/pm2
